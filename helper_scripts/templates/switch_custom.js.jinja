            {% endif %}
            romasku.bindedMode("{{switchName}}_binded_mode", "{{switchName}}"),
            romasku.longPressDuration("{{switchName}}_long_press_duration", "{{switchName}}"),
            romasku.levelMoveRate("{{switchName}}_level_move_rate", "{{switchName}}"),
            {% endfor %}
            {% for relayName in device.relayIndicatorNames %}
            romasku.relayIndicatorMode("{{relayName}}_indicator_mode", "{{relayName}}"),
            romasku.relayIndicator("{{relayName}}_indicator", "{{relayName}}"),
            {% endfor %}
            {% for coverName in device.coverNames %}
            windowCovering({ 
                controls: ["lift"],
                coverInverted: true,
                configureReporting: true,
                endpointNames: ["{{coverName}}"]
            }),
            romasku.coverMoving("moving", "{{coverName}}"),
            romasku.coverMotorReversal("{{coverName}}_motor_reversal", "{{coverName}}"),
            romasku.coverOpenTime("{{coverName}}_open_time", "{{coverName}}"),
            romasku.coverCloseTime("{{coverName}}_close_time", "{{coverName}}"),
            romasku.coverOpenDeadzone("{{coverName}}_open_deadzone", "{{coverName}}"),
            romasku.coverClosedDeadzone("{{coverName}}_closed_deadzone", "{{coverName}}"),
            {% endfor %}
            {% for coverSwitch in device.coverSwitchNames %}
            romasku.coverSwitchPressAction("{{coverSwitch}}_press_action", "{{coverSwitch}}"),
            romasku.coverSwitchType("{{coverSwitch}}_type", "{{coverSwitch}}"),
            romasku.coverSwitchInvert("{{coverSwitch}}_invert", "{{coverSwitch}}"),
            {% if device.coverNames %}
            romasku.coverSwitchCoverIndex("{{coverSwitch}}_cover_index", "{{coverSwitch}}", {{device.coverNames | length}}),
            romasku.coverSwitchLocalMode("{{coverSwitch}}_local_mode", "{{coverSwitch}}"),
            {% endif %}
            romasku.coverSwitchBindedMode("{{coverSwitch}}_binded_mode", "{{coverSwitch}}"),
            romasku.coverSwitchLongPressDuration("{{coverSwitch}}_long_press_duration", "{{coverSwitch}}"),
            {% endfor %}
            {# Dimmers, per channel: the light, its range, curve, power-on, switch, fade and hold. #}
            {% for dimmerName in device.dimmerNames %}
            {% set dimmer_index = loop.index %}
            light({ endpointNames: ["{{dimmerName}}"], effect: false, powerOnBehavior: false }),
            romasku.dimmerMinLevel("min_level", "{{dimmerName}}"),
            romasku.dimmerMaxLevel("max_level", "{{dimmerName}}"),
            romasku.dimmerOnLevel("on_level", "{{dimmerName}}"),
{% for dp in device.dp_attributes if dp.dimmer == dimmer_index and dp.type == "E" %}
{{ dp_extend(dp, device, first_endpoint) }}{% endfor %}
            {% if device.secondary_mcu_image %}
            romasku.dimmerPowerOnChannel("{{dimmerName}}"),
            {% endif %}
            romasku.dimmerSwitchType("switch_type", "{{dimmerName}}"),
{% for dp in device.dp_attributes if dp.dimmer == dimmer_index and dp.type != "E" %}
{{ dp_extend(dp, device, first_endpoint) }}{% endfor %}
            {% endfor %}
            {% if device.dimmerNames and device.secondary_mcu_image %}
            romasku.dimmerGestures({{device.dimmerNames | tojson}}),
            romasku.dimmerPowerOnPerChannel({{device.dimmerNames | tojson}}),
            {% elif device.dimmerNames %}
            // Universal power-on behavior (shared DP, e.g. U0E) - one expose only.
            romasku.dimmerPowerOnBehavior("power_on_behavior"),
            {% endif %}
            {% if device.dimmerNames %}
            // Device: technical settings last.
            {% if device.has_secondary_mcu %}
            romasku.mcuVersion("mcu_version", "{{first_endpoint}}"),
            {% if device.secondary_mcu_image %}
            romasku.mcuFirmware(),
            {% endif %}
            {% endif %}
            romasku.multiPressResetCount("multi_press_reset_count", "{{first_endpoint}}"),
            {% if device.has_dedicated_net_led %}
            romasku.networkIndicator("network_led", "{{first_endpoint}}"),
            {% endif%}
            romasku.deviceConfig("device_config", "{{first_endpoint}}"),
            romasku.deviceConfigExt("device_config_ext", "{{first_endpoint}}"),
            {% if device.dp_relay_cnt > 0 %}romasku.dpConfig("dp_config", "{{first_endpoint}}"),
            {% endif %}
            {% endif %}
        ],
        meta: { multiEndpoint: true },
        {% if device.dimmerNames %}
        {% set dimmer_base = (device.switchNames | length) + (device.relayNames | length) + (device.coverSwitchNames | length) + (device.coverNames | length) %}
        onEvent: romasku.dimmerOnLevelRefresh([{% for dimmerName in device.dimmerNames %}{{loop.index + dimmer_base}}{{ ", " if not loop.last }}{% endfor %}]),
        {% endif %}
        configure: async (device, coordinatorEndpoint, logger) => {
            {% if device.dimmerNames or (device.dp_attributes | selectattr("min_mcu") | list) %}
            // Right after a module restart the module answers with defaults (0) until the MCU
            // has sent its values; reading then would leave 0 on the page. Wait for a real MCU
            // version (a few seconds, longer while the module updates the MCU), then read.
            // A module that does not answer at all is offline: stop after two failed reads
            // in a row, 2 s apart (a single failure, e.g. while routes re-form after a
            // restart, only costs one more try).
            const mcuEndpoint = device.getEndpoint(1);
            let mcuVersion;
            for (let attempt = 0, failures = 0; attempt < 15; attempt++) {
                try {
                    const result = await mcuEndpoint.read("genBasic", [0xff12]); // mcu_version
                    mcuVersion = result?.[0xff12];
                    failures = 0;
                } catch (error) {
                    mcuVersion = undefined; // not answered
                    if (++failures >= 2) break;
                }
                if (realMcuVersion(mcuVersion)) {
                    await new Promise((resolve) => setTimeout(resolve, 1500)); // the rest of its DP dump
                    break;
                }
                await new Promise((resolve) => setTimeout(resolve, 2000));
            }
            {% if device.dp_attributes | selectattr("min_mcu") | list %}
            // Settings only Open Dimmer has ("x.y.z own"): a stock MCU's module answers 0 for them.
            if (typeof mcuVersion === "string" && mcuVersion.endsWith(" own")) {
                {% for dp in device.dp_attributes if dp.min_mcu %}
                try {
                    await mcuEndpoint.read("genBasic", [0x{{("ff" ~ dp.attr)|lower}}]); // {{dp.name}}
                } catch (error) {
                    // not answered now; read on the next configure or with a refresh
                }
                {% endfor %}
            }
            {% endif %}
            {% endif %}
            {% for switchName in device.switchNames %}
            const endpoint{{loop.index}} = device.getEndpoint({{loop.index}});
            await reporting.bind(endpoint{{loop.index}}, coordinatorEndpoint, ["genMultistateInput"]);
            // switch action:
            await endpoint{{loop.index}}.configureReporting("genMultistateInput", [
                {
                    attribute: {ID: 0x0055 /* presentValue */, type: 0x21}, // uint16
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.MAX,
                    reportableChange: 1,
                },
            ]);
            {% endfor %}
            {% if device.has_battery_cluster %}
            // Battery reporting
            const batteryEndpoint = device.getEndpoint(1);
            await reporting.bind(batteryEndpoint, coordinatorEndpoint, ["genPowerCfg"]);
            await batteryEndpoint.configureReporting("genPowerCfg", [
                {
                    attribute: {ID: 0x0021, type: 0x20}, // BatteryPercentageRemaining
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.HOUR,
                    reportableChange: 2, // 1% (2 in ZCL 0-200 format)
                },
            ]);
            await batteryEndpoint.read("genPowerCfg", [0x0021, 0x0020]);
            {% endif %}
            {% for relayName in device.relayNames %}
            const endpoint{{loop.index  + (device.switchNames | length)}} = device.getEndpoint({{loop.index  + (device.switchNames | length)}});
            await reporting.onOff(endpoint{{loop.index  + (device.switchNames | length)}}, {
                min: 0,
                max: constants.repInterval.MAX,
                change: 1,
            });
            {% endfor %}

            {% for relayName in device.relayIndicatorNames %}
            await endpoint{{loop.index  + (device.switchNames | length)}}.configureReporting("genOnOff", [
                {
                    attribute: {ID: 0xff02, type: 0x10}, // Boolean
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.MAX,
                    reportableChange: 1,
                },
            ]);
            {% endfor %}

            {% for coverSwitchName in device.coverSwitchNames %}
            const coverSwitch{{loop.index}} = device.getEndpoint({{loop.index + (device.switchNames | length) + (device.relayNames | length)}});
            await reporting.bind(coverSwitch{{loop.index}}, coordinatorEndpoint, ["genMultistateInput"]);
            await coverSwitch{{loop.index}}.configureReporting("genMultistateInput", [
                {
                    attribute: "presentValue",
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.MAX,
                    reportableChange: 1,
                },
            ]);
            {% endfor %}

            {% for coverName in device.coverNames %}
            const cover{{loop.index}} = device.getEndpoint({{loop.index + (device.switchNames | length) + (device.relayNames | length) + (device.coverSwitchNames | length)}});
            await reporting.bind(cover{{loop.index}}, coordinatorEndpoint, ["closuresWindowCovering"]);
            await cover{{loop.index}}.configureReporting("closuresWindowCovering", [
                {
                    attribute: {ID: 0xff00, type: Zcl.DataType.ENUM8},
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.MAX,
                    reportableChange: 1,
                },
            ]);
            {% endfor %}
            {% for dimmerName in device.dimmerNames %}
            const dimmer{{loop.index}}Dp = {{loop.index + (device.switchNames | length) + (device.relayNames | length) + (device.coverSwitchNames | length) + (device.coverNames | length)}};
            const dimmer{{loop.index}} = device.getEndpoint(dimmer{{loop.index}}Dp);
            await reporting.bind(dimmer{{loop.index}}, coordinatorEndpoint, ["genOnOff", "genLevelCtrl"]);
            await reporting.onOff(dimmer{{loop.index}}, {
                min: 0,
                max: constants.repInterval.MAX,
                change: 1,
            });
            await dimmer{{loop.index}}.configureReporting("genLevelCtrl", [
                {
                    attribute: "currentLevel",
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.MAX,
                    reportableChange: 1,
                },
            ]);
            // The settings shown on the page, read once so none stays unknown.
            for (const [cluster, attrs] of [["genOnOff", ["startUpOnOff"]], ["genLevelCtrl", ["onLevel"]],
                                            ["lightingBallastCfg", ["minLevel", "maxLevel"]],
                                            ["genOnOffSwitchCfg", ["switchType"]]]) {
                try {
                    await dimmer{{loop.index}}.read(cluster, attrs);
                } catch (error) {
                    // not answered now; read on the next configure or with a refresh
                }
            }
            {% if device.secondary_mcu_image %}
            try {
                // Wall switch gestures (Open Dimmer firmware); older module builds lack the cluster.
                // Each gesture is an event: report changes only (maximum interval 0), else
                // the stack repeats the last gesture every maximum interval (and Z2M with it).
                await reporting.bind(dimmer{{loop.index}}, coordinatorEndpoint, ["genMultistateInput"]);
                await dimmer{{loop.index}}.configureReporting("genMultistateInput", [
                    {
                        attribute: {ID: 0x0055 /* presentValue */, type: 0x21}, // uint16
                        minimumReportInterval: 0,
                        maximumReportInterval: 0,
                        reportableChange: 1,
                    },
                ]);
            } catch (error) {
                // not there: no gestures
            }
            {% endif %}
            {% endfor %}
        },
        {% if z2m_v1 %}
        ota: ota.zigbeeOTA,
        {% else %}
        ota: true,
        {% endif%}
    },
{% endfor %}
];

module.exports = definitions;
