            .withValueMin(1).withValueMax(255)
            .withDescription(always
                ? "Brightness the light comes on at from the wall switch or the module button, set without a round trip through the network (not a hold from dark: it rises from the minimum). 255 (default) = as on_level"
                : "Brightness the light comes on at from the wall switch, set without a round trip through the network. 255 (default) = as on_level")
            .withCategory("config");
