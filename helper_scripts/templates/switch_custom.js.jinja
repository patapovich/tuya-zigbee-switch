            ]);
            {% endfor %}
            {% for dimmerName in device.dimmerNames %}
            const dimmer{{loop.index}}Dp = {{loop.index + (device.switchNames | length) + (device.relayNames | length) + (device.coverSwitchNames | length) + (device.coverNames | length)}};
            const dimmer{{loop.index}} = device.getEndpoint(dimmer{{loop.index}}Dp);
            await reporting.bind(dimmer{{loop.index}}, coordinatorEndpoint, ["genOnOff", "genLevelCtrl"]);
            await reporting.onOff(dimmer{{loop.index}}, {
                min: 0,
                max: constants.repInterval.MAX,
                change: 1,
            });
            await dimmer{{loop.index}}.configureReporting("genLevelCtrl", [
                {
                    attribute: "currentLevel",
                    minimumReportInterval: 0,
                    maximumReportInterval: constants.repInterval.MAX,
                    reportableChange: 1,
                },
            ]);
            // The settings shown on the page, read once so none stays unknown.
            for (const [cluster, attrs] of [["genOnOff", ["startUpOnOff"]], ["genLevelCtrl", ["onLevel"]],
                                            ["lightingBallastCfg", ["minLevel", "maxLevel"]],
                                            ["genOnOffSwitchCfg", ["switchType"]]{% if device.hk_dimmer %},
                                            ["genLevelCtrl", ["options", 0xff11, 0xff12]],
                                            ["genOnOff", [0xff10]], ["genOnOffSwitchCfg", [0xff10, 0xff11]],
                                            ["genLevelCtrl", ["startUpCurrentLevel"]], ["lightingBallastCfg", [0xff10, 0xff11]],
                                            ["genOnOffSwitchCfg", [0xff15, 0xff16]]{% if device.dimmer_only %},
                                            ["genOnOffSwitchCfg", [0xff12, 0xff13, 0xff14]]{% if device.dimmerNames|length > 1 %},
                                            ["genOnOffSwitchCfg", [0xff17, 0xff18, 0xff19]]{% endif %}{% endif %}{% endif %}]) {
                try {
                    await dimmer{{loop.index}}.read(cluster, attrs);
                } catch (error) {
                    // not answered now; read on the next configure or with a refresh
                }
            }
            {% if device.secondary_mcu_image or device.hk_dimmer %}
            try {
                // Wall switch gestures (Open Dimmer firmware); older module builds lack the cluster.
                // Each gesture is an event: report changes only (maximum interval 0), else
                // the stack repeats the last gesture every maximum interval (and Z2M with it).
                await reporting.bind(dimmer{{loop.index}}, coordinatorEndpoint, ["genMultistateInput"]);
                await dimmer{{loop.index}}.configureReporting("genMultistateInput", [
                    {
                        attribute: {ID: 0x0055 /* presentValue */, type: 0x21}, // uint16
                        minimumReportInterval: 0,
                        maximumReportInterval: 0,
                        reportableChange: 1,
                    },
                ]);
            } catch (error) {
                // not there: no gestures
            }
            {% endif %}
            {% if device.secondary_mcu_image %}
            if (openDimmer2114) {
                try {
                    await dimmer{{loop.index}}.read("genLevelCtrl", [0xff12]); // brightness_fade_time
                } catch (error) {
                    // not answered now; read on the next configure or with a refresh
                }
            }
            if (openDimmer22) {
                for (const [cluster, attrs] of [["genOnOff", [0xff10]], ["genOnOffSwitchCfg", [0xff10, 0xff11, 0xff15, 0xff16]],
                                                ["genLevelCtrl", ["startUpCurrentLevel", "options", 0xff11]],
                                                ["lightingBallastCfg", [0xff10, 0xff11, 0xff12]]{% if device.dimmer_only %},
                                                ["genOnOffSwitchCfg", [0xff12, 0xff13, 0xff14]]{% if device.dimmerNames|length > 1 %},
                                                ["genOnOffSwitchCfg", [0xff17, 0xff18, 0xff19]]{% endif %}{% endif %}]) {
                    try {
                        await dimmer{{loop.index}}.read(cluster, attrs);
                    } catch (error) {
                        // not answered now; read on the next configure or with a refresh
                    }
                }
            }
            {% endif %}
            {% endfor %}
        },
        {% if z2m_v1 %}
        ota: ota.zigbeeOTA,
        {% else %}
        ota: true,
        {% endif%}
    },
{% endfor %}
];

{% if stock_ota %}
// The stock modules of the dimmer boards converted from stock ({% for stock in stock_ota %}{{ stock.vendor }} {{ stock.model }}{{ ", " if not loop.last }}{% endfor %}):
// zigbee-herdsman-converters' own definition, with OTA, for those boards' stock manufacturer
// names only. Zigbee2MQTT then offers the conversion (the -from_tuya image of the OTA index)
// with this file alone; tuya_with_ota.js gives OTA to some 60 stock models at once.
{% for stock in stock_ota %}
{
    let stockDefinitions = require("zigbee-herdsman-converters/devices/{{ stock.module }}");
    stockDefinitions = stockDefinitions.definitions ?? stockDefinitions;
    const stock = stockDefinitions.find((d) => d.model === "{{ stock.model }}" && d.vendor === "{{ stock.vendor }}");
    if (stock) {
        const {zigbeeModel, ...stockWithoutIds} = stock;   // matched by the fingerprints below only
        definitions.push({
            ...stockWithoutIds,
            fingerprint: [
                {% for name in stock.manufacturer_names %}
                {modelID: "{{ stock.zb_model }}", manufacturerName: "{{ name }}"},
                {% endfor %}
            ],
            {% if z2m_v1 %}
            ota: ota.zigbeeOTA,
            {% else %}
            ota: true,
            {% endif %}
        });
    } else {
        console.warn("switch_custom.js: no stock {{ stock.vendor }} {{ stock.model }} definition in zigbee-herdsman-converters: the conversion OTA is not offered");
    }
}
{% endfor %}
{% endif %}

module.exports = definitions;
