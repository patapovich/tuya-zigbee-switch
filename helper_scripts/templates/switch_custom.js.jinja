    dimmerStartBoost: (endpointName, always = false) => {
        const expose = e.numeric("start_boost", ea.ALL).withEndpoint(endpointName)
            .withValueMin(0).withValueMax(0.75).withValueStep(0.05).withUnit("s")
            .withDescription(always
                ? "Coming on from dark the output is at max_level this long, then goes to the brightness: for LED drivers that need a kick to start (0 = none; in steps of 0.05 s; also before a hold from dark; a transition keeps its end)"
                : "Coming on from dark the output is at full this long, then goes to the brightness: for LED drivers that need a kick to start (0 = none; Open Dimmer firmware)")
            .withCategory("config");
