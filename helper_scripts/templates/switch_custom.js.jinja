            .withDescription(always
                ? "This channel goes along with another channel inside the module, at once (no round trip through the network): when that channel is switched on at its wall switch or the module button, to follow_on_level; when it goes off there or its countdown ends, to follow_off_level. Not its holds, not commands to it; none = off (default)"
                : "This channel goes along with another channel inside the module, at once (no round trip through the network): when that channel is switched on at its wall switch, to follow_on_level; when it goes off at its wall switch or its countdown ends, to follow_off_level. Not its holds, not commands to it; none = off (default)")
            .withCategory("config");
        const on = e.numeric("follow_on_level", ea.ALL).withEndpoint(endpointName).withLabel("Follow on level")
            .withValueMin(1).withValueMax(254)
            .withDescription("Brightness (1..254) this channel goes to when the channel it follows is switched on at its wall switch (default 254; a hold from dark there also starts with this)")
            .withCategory("config");
        const off = e.numeric("follow_off_level", ea.ALL).withEndpoint(endpointName).withLabel("Follow off level")
            .withValueMin(0).withValueMax(254)
            .withDescription(always
                ? "Brightness this channel goes to when the channel it follows goes off at its wall switch or the module button (or its countdown ends): 0 = off (default); above 0 it also comes on if it was off (a night light, e.g. set by an automation while another light is on)"
                : "Brightness this channel goes to when the channel it follows goes off at its wall switch (or its countdown ends): 0 = off (default); above 0 it also comes on if it was off (a night light, e.g. set by an automation while another light is on)")
            .withCategory("config");
        const attr = (expose, id, type, fromValue, toValue) => romasku.dimmerOwnAttr({
            expose, endpointName, cluster: "genOnOffSwitchCfg", attr: {ID: id}, type, fromValue, toValue, always});
        return [
            attr(follow, 0xff17, Zcl.DataType.ENUM8, (v) => (v === 0 ? "none" : dimmerNames[v - 1] ?? v), (value) => {
                if (value === "none") return 0;
                if (!others.includes(value)) throw new Error(`follow: one of ${values.join(", ")}`);
                return dimmerNames.indexOf(value) + 1;
            }),
            attr(on, 0xff18, Zcl.DataType.UINT8, (v) => v, (value) => level("follow_on_level", 1, value)),
            attr(off, 0xff19, Zcl.DataType.UINT8, (v) => v, (value) => level("follow_off_level", 0, value)),
        ];
    },
    // ZCL ExecuteIfOff (Level Control Options bit 0, kept by the module): a brightness change
    // without on/off while off sets the brightness the light comes on at, the light stays off.
