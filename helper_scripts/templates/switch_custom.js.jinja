            .withLabel("Double tap: full brightness")
            .withDescription(always
                ? "Two short taps of a momentary wall switch (normal switch_mode) take the light to its max_level, from off and from on; a tap and a hold still dim, a third tap is a plain one. Off: each tap toggles as usual"
                : "Two short taps of a momentary wall switch (normal switch_mode) take the light to its max_level, from off and from on; a tap and a hold still dim, a third tap is a plain one. Off: each tap toggles as usual (Open Dimmer firmware)")
            .withCategory("config");
