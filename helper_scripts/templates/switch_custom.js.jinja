        {% set first_endpoint = device.switchNames[0] if device.switchNames else (device.relayNames[0] if device.relayNames else (device.coverNames[0] if device.coverNames else device.dimmerNames[0])) %}
        extend: [
            {% if device.has_battery_cluster %}
            romasku.batteryPercentage(),
            {% endif %}
            deviceEndpoints({ endpoints: {
                {%- for switchName in device.switchNames -%}
                    "{{switchName}}": {{loop.index}},{{" "}}
                {%- endfor -%}
                {%- for relayName in device.relayNames -%}
                    "{{relayName}}": {{loop.index  + (device.switchNames | length)}},{{" "}}
                {%- endfor -%}
                {%- for coverSwitchName in device.coverSwitchNames -%}
                    "{{coverSwitchName}}": {{loop.index + (device.switchNames | length) + (device.relayNames | length)}},{{" "}}
                {%- endfor -%}
                {%- for coverName in device.coverNames -%}
                    "{{coverName}}": {{loop.index + (device.switchNames | length) + (device.relayNames | length) + (device.coverSwitchNames | length)}},{{" "}}
                {%- endfor -%}
                {%- for dimmerName in device.dimmerNames -%}
                    "{{dimmerName}}": {{loop.index + (device.switchNames | length) + (device.relayNames | length) + (device.coverSwitchNames | length) + (device.coverNames | length)}},{{" "}}
                {%- endfor -%}
            } }),
            {% set first_endpoint = device.switchNames[0] if device.switchNames else (device.relayNames[0] if device.relayNames else (device.coverSwitchNames[0] if device.coverSwitchNames else (device.coverNames[0] if device.coverNames else device.dimmerNames[0]))) %}
{% if not device.dimmerNames %}
            romasku.deviceConfig("device_config", "{{first_endpoint}}"),
