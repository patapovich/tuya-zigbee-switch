+/* Backported from later SDKs (patch_sdk/zigbee/mac/mac_phy.c.patch, sdk.mk SDK_PATCHED), two
+ * changes in rf_rx_irq_handler(), marked SDK 4.0.x below:
+ * - the ACK of a received frame is timed as SDK 4.0.2.0 times it ("optimize ACK sending timing
+ *   to improve compatibility"): no earlier than 128 + 32 us after the frame's end, counted from
+ *   its RX timestamp. 3.7.2.0 counted only from its own switch to TX, so an early interrupt could
+ *   start the ACK ~140 us after the frame, under the 192 us turnaround a receiver may need. The
+ *   120 us after the switch to TX stays too (the PLL settles in it; 4.0.2.0 drops it when the
+ *   interrupt came late), so an ACK never goes earlier than under 3.7.2.0;
+ * - the ACK to a sleepy child's Data Request has the pending bit while the child's frame is
+ *   already being sent, as SDK 4.0.x's library gives it;
+ * and in rf_performCCA() the receiver settles before the clear channel assessment (SDK 4.0.2.0). */
 /********************************************************************************************************
  * @file    mac_phy.c
