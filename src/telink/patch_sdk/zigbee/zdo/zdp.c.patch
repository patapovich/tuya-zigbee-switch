+#ifdef ZDP_MGMT_RTG_RSP
+/* Mgmt_Rtg_rsp: status, the routing table's entries in use, the start index, the count and up to
+ * ZDP_MGMT_RTG_LIST_MAX routing descriptors from that index (destination, status: route state in
+ * bits 0-2, many-to-one bit 4, route record required bit 5, next hop). An entry not in use (cleared
+ * by the library: destination 0xFFFE) is left out. The request's buffer carries the answer. */
+#define ZDP_MGMT_RTG_LIST_MAX     10
+#define ZDP_MGMT_RTG_UNUSED       0xFFFE
+
+_CODE_ZDO_ static void zdo_mgmtRtgIndicate(void *buf)
+{
+    aps_data_ind_t *ad = (aps_data_ind_t *)buf;
+    u8 seqNum = ad->asdu[0];
+    u8 startIdx = (ad->asduLength > 1) ? ad->asdu[1] : 0;
+    u16 dstAddr = ad->src_short_addr;
+
+    u8 total = 0;
+    for (u16 i = 0; i < ROUTING_TABLE_SIZE; i++) {
+        if (g_routingTab[i].dstAddr != ZDP_MGMT_RTG_UNUSED) {
+            total++;
+        }
+    }
+
+    zdo_zdp_req_t zzr;
+    TL_SETSTRUCTCONTENT(zzr, 0);
+    TL_BUF_INITIAL_ALLOC((zb_buf_t *)buf, 5 + 5 * ZDP_MGMT_RTG_LIST_MAX, zzr.zdu, u8 *);
+    u8 *ptr = zzr.zdu;
+    *ptr++ = seqNum;
+    *ptr++ = ZDO_SUCCESS;
+    *ptr++ = total;
+    *ptr++ = startIdx;
+    u8 *listCnt = ptr++;
+    *listCnt = 0;
+
+    u8 idx = 0;
+    for (u16 i = 0; i < ROUTING_TABLE_SIZE && *listCnt < ZDP_MGMT_RTG_LIST_MAX; i++) {
+        nwk_routingTabEntry_t *e = &g_routingTab[i];
+        if (e->dstAddr == ZDP_MGMT_RTG_UNUSED) {
+            continue;
+        }
+        if (idx++ < startIdx) {
+            continue;
+        }
+        COPY_U16TOBUFFER(ptr, e->dstAddr);
+        ptr += 2;
+        *ptr++ = (e->status & 0x07) | (e->manyToOne << 4) | (e->routeRecordRequired << 5);
+        COPY_U16TOBUFFER(ptr, e->nextHopAddr);
+        ptr += 2;
+        (*listCnt)++;
+    }
+
+    zzr.cluster_id = MGMT_RTG_RSP_CLID;
+    zzr.zduLen = ptr - zzr.zdu;
+    zzr.buff_addr = buf;
+    zzr.dst_addr_mode = SHORT_ADDR_MODE;
+    zzr.dst_nwk_addr = dstAddr;
+    zzr.zdoRspReceivedIndCb = NULL;
+    zdo_send_req(&zzr);
+    zb_buf_free((zb_buf_t *)buf);
+}
+#endif
+
